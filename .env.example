# ═══════════════════════════════════════════
# Cognitive CRM — Environment Configuration
# ═══════════════════════════════════════════

# ── Application ──
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ── Database (PostgreSQL) ──
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_secret_2024
POSTGRES_DB=cognitive_crm
DATABASE_URL=postgresql://crm_user:crm_secret_2024@localhost:5432/cognitive_crm?schema=public

# ── Redis (BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── SMTP (Email) ──
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
SMTP_FROM="Cognitive CRM" <noreply@cognitivecrm.com>

# ── Scraper ──
SCRAPER_MAX_CONCURRENCY=3
SCRAPER_REQUEST_DELAY_MS=1500
SCRAPER_MAX_RETRIES=3

# ── Frontend ──
VITE_API_BASE_URL=http://localhost:3000/api
